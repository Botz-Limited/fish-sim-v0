<?xml version="1.0" encoding="UTF-8" ?>
<!-- ====================================================================== -->
<!-- Konfiguracja preCICE v3: ogon ryby (CalculiX) w wodzie (OpenFOAM).     -->
<!-- Wariant: sprzężenie NIEJAWNE (implicit) z akceleracją quasi-Newtona.   -->
<!-- Na bazie tutorialu perpendicular-flap (preCICE tutorials, develop).    -->
<!-- ====================================================================== -->
<precice-configuration>
  <!-- Logi preCICE: informacje z procesu 0, ostrzeżenia i błędy ze wszystkich -->
  <log>
    <sink
      filter="(%Severity% > debug and %Rank% = 0) or %Severity% > info"
      format="---[precice] %ColorizedSeverity% %Message%"
      enabled="true" />
  </log>

  <!-- Podstawowy profil czasów (precice-profiling) – pokazuje, ile czasu
       zajmuje płyn, ciało stałe, mapowanie i komunikacja -->
  <profiling mode="fundamental" synchronize="false" />

  <!-- Wymieniane dane: siła od wody na ogon i przemieszczenie ogona -->
  <data:vector name="Force" />
  <data:vector name="Displacement" />

  <!-- Siatki interfejsu (2D: preCICE widzi przekrój x-y).
       Fluid-Mesh: środki ścian patcha "tail" w OpenFOAM.
       Solid-Mesh: węzły zbioru Nsurface w CalculiX. -->
  <mesh name="Fluid-Mesh" dimensions="2">
    <use-data name="Force" />
    <use-data name="Displacement" />
  </mesh>

  <mesh name="Solid-Mesh" dimensions="2">
    <use-data name="Displacement" />
    <use-data name="Force" />
  </mesh>

  <participant name="Fluid">
    <provide-mesh name="Fluid-Mesh" />
    <receive-mesh name="Solid-Mesh" from="Solid" />
    <write-data name="Force" mesh="Fluid-Mesh" />
    <read-data name="Displacement" mesh="Fluid-Mesh" />
    <!-- MAPOWANIE. Siatki płynu i ciała stałego się nie pokrywają (inne
         rozmieszczenie punktów), więc dane trzeba przenieść interpolacją.
         RBF (radialne funkcje bazowe) nie potrzebuje połączeń między punktami,
         a CalculiX przekazuje tylko węzły – stąd RBF, jak w tutorialu.
         * Siła: "conservative" – suma sił węzłowych zostaje zachowana
           (inaczej zmieniłby się wypadkowy ciąg/opór).
         * Przemieszczenie: "consistent" – wartość w punkcie jest
           interpolowana (stałe przesunięcie musi zostać stałe).
         Promień nośnika 5 mm: obejmuje kilka punktów każdej siatki, ale jest
         mniejszy od grubości końcówki (10 mm), więc lewa i prawa powierzchnia
         ogona słabo się "mieszają". PLACEHOLDER – sprawdzić przy zagęszczaniu. -->
    <mapping:rbf direction="write" from="Fluid-Mesh" to="Solid-Mesh" constraint="conservative">
      <basis-function:compact-polynomial-c6 support-radius="0.005" />
    </mapping:rbf>
    <mapping:rbf direction="read" from="Solid-Mesh" to="Fluid-Mesh" constraint="consistent">
      <basis-function:compact-polynomial-c6 support-radius="0.005" />
    </mapping:rbf>
  </participant>

  <participant name="Solid">
    <provide-mesh name="Solid-Mesh" />
    <write-data name="Displacement" mesh="Solid-Mesh" />
    <read-data name="Force" mesh="Solid-Mesh" />
    <!-- Punkt obserwacji: środek końcówki ogona (x = L = 0.15 m, y = 0).
         Zapisuje plik precice-Solid-watchpoint-Tip.log -->
    <watch-point mesh="Solid-Mesh" name="Tip" coordinate="0.15;0.0" />
  </participant>

  <!-- Komunikacja przez gniazda TCP; pliki adresowe w katalogu wyżej -->
  <m2n:sockets acceptor="Fluid" connector="Solid" exchange-directory=".." />

  <!-- SCHEMAT SPRZĘŻENIA.
       Gęstość silikonu (~1070) jest prawie równa gęstości wody (1000).
       Woda, którą ogon musi rozpychać, działa jak dodatkowa masa ("masa
       dodana") porównywalna z masą samego ogona. Przy sprzężeniu jawnym
       (jedna wymiana na krok) taka pętla jest bezwarunkowo niestabilna –
       błąd rośnie z kroku na krok (patrz wariant explicit, etap 3).
       Dlatego: parallel-implicit = w każdym oknie czasowym oba solvery
       liczą równocześnie i powtarzają krok, aż siły i przemieszczenia na
       interfejsie przestaną się zmieniać. -->
  <coupling-scheme:parallel-implicit>
    <!-- Okno czasowe = krok czasowy obu solverów (DELTA_T w caseParams i w fsi.inp) -->
    <time-window-size value="@DT@" />
    <max-time value="@T_END@" />
    <participants first="Fluid" second="Solid" />
    <exchange data="Force" mesh="Solid-Mesh" from="Fluid" to="Solid" />
    <exchange data="Displacement" mesh="Solid-Mesh" from="Solid" to="Fluid" />
    <!-- Maks. liczba iteracji w oknie; po jej przekroczeniu preCICE idzie
         dalej mimo braku zbieżności (sprawdzamy to w check_results.py) -->
    <max-iterations value="50" />
    <!-- Kryterium zbieżności: względna zmiana między iteracjami < 1e-3 -->
    <relative-convergence-measure limit="1e-3" data="Displacement" mesh="Solid-Mesh" />
    <relative-convergence-measure limit="1e-3" data="Force" mesh="Solid-Mesh" />
    <!-- IQN-ILS (interface quasi-Newton, inverse least squares): na podstawie
         poprzednich iteracji buduje przybliżenie jakobianu interfejsu i
         "przewiduje" lepsze dane wejściowe. Zbiega w kilku iteracjach tam,
         gdzie zwykła relaksacja potrzebowałaby dziesiątek. -->
    <acceleration:IQN-ILS>
      <data name="Displacement" mesh="Solid-Mesh" />
      <data name="Force" mesh="Solid-Mesh" />
      <!-- skalowanie: siły [N] i przemieszczenia [m] mają różne rzędy wielkości -->
      <preconditioner type="residual-sum" />
      <!-- filtr QR usuwa prawie liniowo zależne kolumny (stabilność numeryczna) -->
      <filter type="QR3" limit="1e-3" />
      <!-- pierwsza iteracja pierwszego okna: zwykła relaksacja z tym współczynnikiem -->
      <initial-relaxation value="0.1" />
      <max-used-iterations value="100" />
      <!-- używaj informacji z 10 poprzednich okien (szybsza zbieżność) -->
      <time-windows-reused value="10" />
    </acceleration:IQN-ILS>
  </coupling-scheme:parallel-implicit>
</precice-configuration>
