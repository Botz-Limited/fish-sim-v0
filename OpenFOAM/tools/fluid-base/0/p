FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];   // ciśnienie kinematyczne p/rho [m^2/s^2]

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }

    // Poziom odniesienia ciśnienia: 0 na wylocie
    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }

    sides
    {
        type            zeroGradient;
    }

    head
    {
        type            zeroGradient;
    }

    // fixedFluxPressure: gradient ciśnienia zgodny z ruchem ściany (ważne
    // przy ruchomej siatce – inaczej strumień przez ścianę nie jest zerowy)
    tail
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    frontAndBack
    {
        type            empty;
    }
}

