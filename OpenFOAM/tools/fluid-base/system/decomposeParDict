FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Mesh decomposition into MPI processes. On the 6-core Ryzen: 4 fluid processes,
// the remaining cores are left for CalculiX (OpenMP) in the FSI stages.
numberOfSubdomains 4;

// scotch: automatic decomposition minimising the boundaries between processes
method          scotch;

