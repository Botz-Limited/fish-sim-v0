FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/system/caseParams"

dimensions      [0 1 -1 0 0 0 0];

// Start from water at rest; the inflow grows linearly over U_RAMP seconds
// Start from a uniform inflow field (settles faster than starting from rest)
internalField   uniform ($U_IN 0 0);

boundaryField
{
    // Inlet: prescribed inflow velocity
    inlet
    {
        type            fixedValue;
        value           uniform ($U_IN 0 0);
    }

    // Outlet: zero gradient for outflow, but when a vortex re-enters the domain
    // (backflow) – zero velocity. More stable than plain zeroGradient.
    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           $internalField;
    }

    // Side walls: slip – we mimic an unbounded medium (no boundary layer on
    // the channel walls). The effect of their distance is checked in stage 2.
    sides
    {
        type            slip;
    }

    // Rigid head: no slip
    head
    {
        type            noSlip;
    }

    // Tail: moving wall – fluid velocity = wall velocity (from mesh motion).
    // For a static mesh (stage 2) this is the same as noSlip.
    tail
    {
        type            movingWallVelocity;
        value           uniform (0 0 0);
    }

    // 2D: front and back of the domain are not solved
    frontAndBack
    {
        type            empty;
    }
}

