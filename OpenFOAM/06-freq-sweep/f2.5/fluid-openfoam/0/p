FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];   // kinematic pressure p/rho [m^2/s^2]

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }

    // Pressure reference level: 0 at the outlet
    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }

    sides
    {
        type            zeroGradient;
    }

    head
    {
        type            zeroGradient;
    }

    // fixedFluxPressure: pressure gradient consistent with the wall motion
    // (important with a moving mesh – otherwise the flux through the wall is not zero)
    tail
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    frontAndBack
    {
        type            empty;
    }
}

// ************************************************************************* //
