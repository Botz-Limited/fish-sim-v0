FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    // Pressure: GAMG (multigrid) – fastest for the Poisson equation
    "(p|pcorr)"
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-7;
        relTol          0.01;
    }

    "(p|pcorr)Final"
    {
        $p;
        relTol          0;
    }

    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0.01;
    }

    UFinal
    {
        $U;
        relTol          0;
    }

    // Mesh motion equation (Laplace for displacements); "Final" = last
    // PIMPLE loop – same settings
    "cellDisplacement(Final)?"
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-8;
        relTol          0;
    }
}

PIMPLE
{
    // 1 outer loop = PISO mode (enough for Co < 1).
    // With implicit coupling preCICE repeats the step several times anyway.
    nOuterCorrectors        1;
    nCorrectors             2;
    // the gmsh mesh is not orthogonal -> one extra correction
    nNonOrthogonalCorrectors 1;
    momentumPredictor       yes;
    consistent              no;
    // after mesh motion correct the fluxes to conserve mass
    correctPhi              yes;
    moveMeshOuterCorrectors no;
}

