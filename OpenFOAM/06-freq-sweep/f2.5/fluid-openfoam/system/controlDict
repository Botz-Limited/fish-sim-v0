FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "caseParams"

// pimpleFoam: incompressible, transient, laminar or turbulent solver.
// Supports a moving mesh (constant/dynamicMeshDict).
application     pimpleFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         $END_TIME;

// Fixed time step: with preCICE coupling both solvers must use the same step
// (time-window-size). The Courant number is controlled by choosing DELTA_T.
deltaT          $DELTA_T;
adjustTimeStep  no;

writeControl    adjustableRunTime;
writeInterval   $WRITE_INTERVAL;
purgeWrite      0;
writeFormat     binary;         // binary = faster and smaller
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   8;
runTimeModifiable false;        // do not re-read files every step (faster)

functions
{
    // Water force on the whole body (head + tail) -> postProcessing/forces*/
    // x component: positive = drag, negative = thrust.
    forcesBody
    {
        type            forces;
        libs            (forces);
        writeControl    timeStep;
        writeInterval   1;
        patches         (head tail);
        rho             rhoInf;     // incompressible solver: density given here
        rhoInf          $RHO;
        CofR            (0 0 0);    // moment about the tail root
    }

    // Same, but the tail only
    forcesTail
    {
        $forcesBody;
        patches         (tail);
    }

    // Vorticity (curl U) – for wake snapshots in ParaView
    vorticity
    {
        type            vorticity;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
    }

    // Courant number in the log (time step check)
    CourantNo
    {
        type            CourantNo;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
    }

    // Time averaging (from AVG_START): pMean, UMean
    fieldAverage
    {
        type            fieldAverage;
        libs            (fieldFunctionObjects);
        timeStart       $AVG_START;
        writeControl    writeTime;
        fields
        (
            p { mean on; prime2Mean off; base time; }
            U { mean on; prime2Mean off; base time; }
        );
    }

    // Pressure on the body surface (instantaneous and mean) -> postProcessing/bodySurface
    bodySurface
    {
        type            surfaces;
        libs            (sampling);
        writeControl    writeTime;
        surfaceFormat   raw;
        fields          (p pMean);
        interpolationScheme cell;
        surfaces
        {
            body
            {
                type        patch;
                patches     (head tail);
                interpolate false;
            }
        }
    }

    // preCICE adapter – the file exists only in FSI cases (stages 3–6)
    #includeIfPresent "preciceFunctionObject"
}

