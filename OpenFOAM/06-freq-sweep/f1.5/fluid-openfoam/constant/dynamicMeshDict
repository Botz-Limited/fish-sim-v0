FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Fluid mesh motion: the mesh deforms (without topology changes) so that it
// follows the tail.
dynamicFvMesh   dynamicMotionSolverFvMesh;

motionSolverLibs ("libfvMotionSolvers.so");

// Interior mesh displacements from the Laplace equation:
//   div( gamma * grad(d) ) = 0,  d – displacement, gamma – diffusivity
solver          displacementLaplacian;

displacementLaplacianCoeffs
{
    // Diffusivity grows like 1/r^2 near the tail: cells close to the body
    // move almost like a rigid body (the boundary layer stays intact), and
    // the deformation is "absorbed" by the large cells further away.
    diffusivity     quadratic inverseDistance (tail head);
}

