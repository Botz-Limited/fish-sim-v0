FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Water as a Newtonian fluid
transportModel  Newtonian;

// Kinematic viscosity of water [m^2/s] (approx. 20 °C)
nu              1e-06;

