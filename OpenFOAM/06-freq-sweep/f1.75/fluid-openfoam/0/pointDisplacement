FoamFile
{
    version     2.0;
    format      ascii;
    class       pointVectorField;
    object      pointDisplacement;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Displacement of the fluid mesh points. On the tail the values are written by
// the preCICE adapter (displacements from CalculiX); the interior is computed
// by the mesh motion solver.

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }

    outlet
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }

    // Sides: points may slide along the wall
    sides
    {
        type            slip;
    }

    // The head is rigid and fixed
    head
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }

    // Tail: value overwritten by the preCICE adapter in every iteration
    tail
    {
        type            fixedValue;
        value           $internalField;
    }

    frontAndBack
    {
        type            empty;
    }
}

