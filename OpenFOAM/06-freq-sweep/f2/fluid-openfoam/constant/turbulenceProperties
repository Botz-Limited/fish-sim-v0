FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// SIMPLIFICATION: the flow is computed as laminar.
// At U ~ 0.2 m/s and length ~0.2 m the Reynolds number Re = U*L/nu ~ 4e4,
// so in reality the flow is transitional/turbulent. The 2D demo deliberately
// omits a turbulence model (see README, section "Limitations").
simulationType  laminar;

