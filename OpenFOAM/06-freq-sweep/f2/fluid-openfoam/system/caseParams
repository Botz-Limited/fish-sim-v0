FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      caseParams;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Parametry tego przypadku (wczytywane przez 0/*, controlDict i preciceDict).
// Zmieniaj tylko tutaj.

// Prędkość napływu [m/s]. 0 = woda stojąca.
// PLACEHOLDER – do identyfikacji z pomiarów (prędkość pływania ryby)
U_IN            0;

// Czas narastania napływu od 0 do U_IN [s]. Nagły start daje uderzenie
// ciśnienia (w 1. kroku ~66 N/m), które "kopnęłoby" miękki ogon.
U_RAMP          0.5;

// Krok czasowy [s] i czas końcowy [s].
// Przy sprzężeniu z preCICE krok narzuca time-window-size w precice-config.xml,
// ale OpenFOAM musi dostać ten sam deltaT.
DELTA_T         0.0025;
END_TIME        4;

// Co ile sekund zapisywać pola (do ParaView).
WRITE_INTERVAL  0.05;

// Od kiedy uśredniać pola w czasie (pMean, UMean) [s] – po zaniku rozruchu.
AVG_START       5;

// Gęstość wody [kg/m^3] – OpenFOAM (pimpleFoam) liczy ciśnienie kinematyczne
// p/rho, więc siły w N/m dostajemy, mnożąc przez RHO.
RHO             1000;

