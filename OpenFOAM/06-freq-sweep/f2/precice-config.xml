<?xml version="1.0" encoding="UTF-8" ?>
<!-- ====================================================================== -->
<!-- preCICE v3 configuration: fish tail (CalculiX) in water (OpenFOAM).    -->
<!-- Variant: IMPLICIT coupling with quasi-Newton acceleration.            -->
<!-- Based on the perpendicular-flap tutorial (preCICE tutorials, develop). -->
<!-- ====================================================================== -->
<precice-configuration>
  <!-- preCICE logs: info from rank 0, warnings and errors from all ranks -->
  <log>
    <sink
      filter="(%Severity% > debug and %Rank% = 0) or %Severity% > info"
      format="---[precice] %ColorizedSeverity% %Message%"
      enabled="true" />
  </log>

  <!-- Basic timing profile (precice-profiling) – shows how much time is
       spent in the fluid, the solid, mapping and communication -->
  <profiling mode="fundamental" synchronize="false" />

  <!-- Exchanged data: water force on the tail and tail displacement -->
  <data:vector name="Force" />
  <data:vector name="Displacement" />

  <!-- Interface meshes (2D: preCICE sees the x-y section).
       Fluid-Mesh: face centres of the "tail" patch in OpenFOAM.
       Solid-Mesh: nodes of the Nsurface set in CalculiX. -->
  <mesh name="Fluid-Mesh" dimensions="2">
    <use-data name="Force" />
    <use-data name="Displacement" />
  </mesh>

  <mesh name="Solid-Mesh" dimensions="2">
    <use-data name="Displacement" />
    <use-data name="Force" />
  </mesh>

  <participant name="Fluid">
    <provide-mesh name="Fluid-Mesh" />
    <receive-mesh name="Solid-Mesh" from="Solid" />
    <write-data name="Force" mesh="Fluid-Mesh" />
    <read-data name="Displacement" mesh="Fluid-Mesh" />
    <!-- MAPPING. The fluid and solid meshes do not coincide (different
         point locations), so data must be transferred by interpolation.
         RBF (radial basis functions) needs no connectivity between points,
         and CalculiX provides nodes only – hence RBF, as in the tutorial.
         * Force: "conservative" – the sum of nodal forces is preserved
           (otherwise the resulting thrust/drag would change).
         * Displacement: "consistent" – the value at a point is
           interpolated (a constant shift must stay constant).
         Support radius 5 mm: covers several points of each mesh but is
         smaller than the tip thickness (10 mm), so the left and right tail
         surfaces barely "mix". PLACEHOLDER – check when refining. -->
    <mapping:rbf direction="write" from="Fluid-Mesh" to="Solid-Mesh" constraint="conservative">
      <basis-function:compact-polynomial-c6 support-radius="0.005" />
    </mapping:rbf>
    <mapping:rbf direction="read" from="Solid-Mesh" to="Fluid-Mesh" constraint="consistent">
      <basis-function:compact-polynomial-c6 support-radius="0.005" />
    </mapping:rbf>
  </participant>

  <participant name="Solid">
    <provide-mesh name="Solid-Mesh" />
    <write-data name="Displacement" mesh="Solid-Mesh" />
    <read-data name="Force" mesh="Solid-Mesh" />
    <!-- Watch point: centre of the tail tip (x = L = 0.15 m, y = 0).
         Writes the file precice-Solid-watchpoint-Tip.log -->
    <watch-point mesh="Solid-Mesh" name="Tip" coordinate="0.15;0.0" />
  </participant>

  <!-- Communication via TCP sockets; address files in the parent directory -->
  <m2n:sockets acceptor="Fluid" connector="Solid" exchange-directory=".." />

  <!-- COUPLING SCHEME.
       The density of silicone (~1070) is almost equal to that of water (1000).
       The water the tail has to push aside acts as extra mass ("added
       mass") comparable to the mass of the tail itself. With explicit coupling
       (one exchange per step) such a loop is unconditionally unstable –
       the error grows from step to step (see the explicit variant, stage 3).
       Therefore: parallel-implicit = in every time window both solvers
       run simultaneously and repeat the step until the forces and
       displacements on the interface stop changing. -->
  <coupling-scheme:parallel-implicit>
    <!-- Time window = time step of both solvers (DELTA_T in caseParams and in fsi.inp) -->
    <time-window-size value="0.0025" />
    <max-time value="4" />
    <participants first="Fluid" second="Solid" />
    <exchange data="Force" mesh="Solid-Mesh" from="Fluid" to="Solid" />
    <exchange data="Displacement" mesh="Solid-Mesh" from="Solid" to="Fluid" />
    <!-- Max. number of iterations per window; beyond it preCICE moves on
         despite no convergence (checked in check_results.py) -->
    <max-iterations value="50" />
    <!-- Convergence criterion: relative change between iterations < 1e-3 -->
    <relative-convergence-measure limit="1e-3" data="Displacement" mesh="Solid-Mesh" />
    <relative-convergence-measure limit="1e-3" data="Force" mesh="Solid-Mesh" />
    <!-- IQN-ILS (interface quasi-Newton, inverse least squares): builds an
         approximation of the interface Jacobian from previous iterations and
         "predicts" better input data. Converges in a few iterations where
         plain relaxation would need dozens. -->
    <acceleration:IQN-ILS>
      <data name="Displacement" mesh="Solid-Mesh" />
      <data name="Force" mesh="Solid-Mesh" />
      <!-- scaling: forces [N] and displacements [m] have different orders of magnitude -->
      <preconditioner type="residual-sum" />
      <!-- QR filter removes nearly linearly dependent columns (numerical stability) -->
      <filter type="QR3" limit="1e-3" />
      <!-- first iteration of the first window: plain relaxation with this factor -->
      <initial-relaxation value="0.1" />
      <max-used-iterations value="100" />
      <!-- reuse information from the 10 previous windows (faster convergence) -->
      <time-windows-reused value="10" />
    </acceleration:IQN-ILS>
  </coupling-scheme:parallel-implicit>
</precice-configuration>
