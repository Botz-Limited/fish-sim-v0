FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    // Ciśnienie: GAMG (wielosiatkowy) – najszybszy dla równania Poissona
    "(p|pcorr)"
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-7;
        relTol          0.01;
    }

    "(p|pcorr)Final"
    {
        $p;
        relTol          0;
    }

    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0.01;
    }

    UFinal
    {
        $U;
        relTol          0;
    }

    // Równanie ruchu siatki (Laplace dla przemieszczeń); "Final" = ostatnia
    // pętla PIMPLE – te same ustawienia
    "cellDisplacement(Final)?"
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-8;
        relTol          0;
    }
}

PIMPLE
{
    // 1 pętla zewnętrzna = tryb PISO (wystarczy przy Co < 1).
    // W sprzężeniu niejawnym preCICE i tak powtarza krok kilka razy.
    nOuterCorrectors        1;
    nCorrectors             2;
    // siatka z gmsh nie jest ortogonalna -> jedna dodatkowa korekcja
    nNonOrthogonalCorrectors 1;
    momentumPredictor       yes;
    consistent              no;
    // po ruchu siatki popraw strumienie, żeby zachować masę
    correctPhi              yes;
    moveMeshOuterCorrectors no;
}

