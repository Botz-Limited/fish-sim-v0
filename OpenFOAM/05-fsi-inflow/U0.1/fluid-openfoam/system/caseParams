FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      caseParams;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Parameters of this case (read by 0/*, controlDict and preciceDict).
// Change them only here.

// Inflow velocity [m/s]. 0 = still water.
// PLACEHOLDER – to be identified from measurements (fish swimming speed)
U_IN            0.1;

// Ramp time of the inflow from 0 to U_IN [s]. A sudden start gives a pressure
// shock (~66 N/m in the 1st step) that would "kick" the soft tail.
U_RAMP          0.5;

// Time step [s] and end time [s].
// With preCICE coupling the step is set by time-window-size in precice-config.xml,
// but OpenFOAM must get the same deltaT.
DELTA_T         0.0025;
END_TIME        5;

// How often (in seconds) to write fields (for ParaView).
WRITE_INTERVAL  0.1;

// When to start time-averaging fields (pMean, UMean) [s] – after the start-up transient.
AVG_START       5;

// Water density [kg/m^3] – OpenFOAM (pimpleFoam) computes the kinematic pressure
// p/rho, so forces in N/m are obtained by multiplying by RHO.
RHO             1000;

