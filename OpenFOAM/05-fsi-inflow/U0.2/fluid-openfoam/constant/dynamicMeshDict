    format      ascii;
    class       dictionary;
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Ruch siatki płynu: siatka deformuje się (bez zmiany topologii) tak, żeby
// nadążać za ogonem.
dynamicFvMesh   dynamicMotionSolverFvMesh;

motionSolverLibs ("libfvMotionSolvers.so");

// Przemieszczenia wnętrza siatki z równania Laplace'a:
//   div( gamma * grad(d) ) = 0,  d – przemieszczenie, gamma – dyfuzyjność
solver          displacementLaplacian;

displacementLaplacianCoeffs
{
    // Dyfuzyjność rośnie jak 1/r^2 przy ogonie: komórki blisko ciała
    // przesuwają się prawie jak ciało sztywne (warstwa przyścienna zostaje
    // nietknięta), a deformację "przejmują" duże komórki dalej.
    diffusivity     quadratic inverseDistance (tail head);
}

