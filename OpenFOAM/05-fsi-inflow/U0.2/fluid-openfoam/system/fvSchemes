FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    // backward: second order in time (Euler is only first order and
    // artificially damps oscillations). Adapter v1.4 checkpoints V0/V00
    // correctly, so backward works with implicit coupling.
    default         backward;
}

gradSchemes
{
    default         Gauss linear;
    // limited gradient for the convection term – fewer oscillations
    grad(U)         cellLimited Gauss linear 1;
}

divSchemes
{
    default         none;
    // linearUpwind: second order, stable on unstructured meshes
    div(phi,U)      Gauss linearUpwind grad(U);
    div((nuEff*dev2(T(grad(U))))) Gauss linear;
}

laplacianSchemes
{
    // "limited corrected 0.5": non-orthogonal correction limited to
    // one half – an accuracy/stability compromise on a gmsh mesh that
    // additionally deforms in time
    default         Gauss linear limited corrected 0.5;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         limited corrected 0.5;
}

wallDist
{
    method          meshWave;
}

