<?xml version="1.0"?>
<!--
  Scenario 3 – turning: CPG with a volume bias V_bias -> tail permanently bent to one side
  -> arc trajectory in the XY plane. Start at x = −8 m: arcs with a radius of a few metres
  do not catch the reference pillars (in the first version the fish hit them). The bias is set by config/s3_turn.json (or --set).
-->
<scenario>
    <!-- Environment: ocean without waves (waves require a GPU – they do not work in console mode). -->
    <environment>
        <ned latitude="41.77" longitude="3.03"/>
        <ocean>
            <water density="@RHO_WATER@" jerlov="0.2"/>
            <waves height="0.0"/>
        </ocean>
        <atmosphere>
            <sun azimuth="20.0" elevation="50.0"/>
        </atmosphere>
    </environment>

    <!-- Physical materials: Stonefish allows defining them ONLY in the main file. -->
    <materials>
        <material name="Hull" density="@RHO_HULL@" restitution="0.3"/>
        <material name="Silicone" density="@RHO_TAIL@" restitution="0.2"/>
        <material name="Steel" density="@RHO_BALLAST@" restitution="0.5"/>
        <material name="Rock" density="3000.0" restitution="0.5"/>
        <friction_table>
            <friction material1="Hull" material2="Hull" static="0.5" dynamic="0.3"/>
            <friction material1="Hull" material2="Silicone" static="0.6" dynamic="0.4"/>
            <friction material1="Hull" material2="Steel" static="0.5" dynamic="0.3"/>
            <friction material1="Hull" material2="Rock" static="0.6" dynamic="0.4"/>
            <friction material1="Silicone" material2="Silicone" static="0.9" dynamic="0.7"/>
            <friction material1="Silicone" material2="Steel" static="0.7" dynamic="0.5"/>
            <friction material1="Silicone" material2="Rock" static="0.8" dynamic="0.6"/>
            <friction material1="Steel" material2="Steel" static="0.4" dynamic="0.2"/>
            <friction material1="Steel" material2="Rock" static="0.5" dynamic="0.3"/>
            <friction material1="Rock" material2="Rock" static="0.9" dynamic="0.7"/>
        </friction_table>
    </materials>

    <include file="scenarios/world_base.scn"/>

    <include file="scenarios/fish_base.scn">
        <arg name="xyz" value="-8.0 0.0 1.5"/>   <!-- away from the pillars (the arcs must not hit them) -->
        <arg name="rpy" value="0.0 0.0 0.0"/>
        <arg name="physics" value="submerged"/>
        <arg name="tail_joint" value="revolute"/>
        <arg name="vbs_initial" value="@VBS_NEUTRAL@"/>
    </include>
</scenario>
