<?xml version="1.0"?>
<!--
  Wspólne otoczenie: dno basenu i obiekty referencyjne (żeby w podglądzie było widać ruch).
  Ciała statyczne – nie mają dynamiki, służą tylko do kolizji i renderingu.
  NED: z rośnie w dół, więc dno na z = 4 m to 4 m pod powierzchnią.
-->
<scenario>
    <looks>
        <look name="seabed" rgb="0.75 0.70 0.55" roughness="0.9"/>
        <look name="rock" rgb="0.35 0.33 0.30" roughness="0.8"/>
        <look name="pillar" rgb="0.85 0.85 0.80" roughness="0.4"/>
        <look name="buoy" rgb="0.9 0.15 0.1" roughness="0.3"/>
    </looks>

    <static name="Bottom" type="plane">
        <material name="Rock"/>
        <look name="seabed"/>
        <world_transform xyz="0.0 0.0 4.0" rpy="0.0 0.0 0.0"/>
    </static>

    <!-- Słupy co 1 m wzdłuż osi X (kierunek pływania), po obu stronach toru ryby. -->
    <static name="PillarL0" type="cylinder"><dimensions radius="0.03" height="4.0"/><material name="Rock"/><look name="pillar"/><world_transform xyz="0.0 -0.8 2.0" rpy="0.0 0.0 0.0"/></static>
    <static name="PillarR0" type="cylinder"><dimensions radius="0.03" height="4.0"/><material name="Rock"/><look name="pillar"/><world_transform xyz="0.0 0.8 2.0" rpy="0.0 0.0 0.0"/></static>
    <static name="PillarL1" type="cylinder"><dimensions radius="0.03" height="4.0"/><material name="Rock"/><look name="pillar"/><world_transform xyz="1.0 -0.8 2.0" rpy="0.0 0.0 0.0"/></static>
    <static name="PillarR1" type="cylinder"><dimensions radius="0.03" height="4.0"/><material name="Rock"/><look name="pillar"/><world_transform xyz="1.0 0.8 2.0" rpy="0.0 0.0 0.0"/></static>
    <static name="PillarL2" type="cylinder"><dimensions radius="0.03" height="4.0"/><material name="Rock"/><look name="pillar"/><world_transform xyz="2.0 -0.8 2.0" rpy="0.0 0.0 0.0"/></static>
    <static name="PillarR2" type="cylinder"><dimensions radius="0.03" height="4.0"/><material name="Rock"/><look name="pillar"/><world_transform xyz="2.0 0.8 2.0" rpy="0.0 0.0 0.0"/></static>
    <static name="PillarL3" type="cylinder"><dimensions radius="0.03" height="4.0"/><material name="Rock"/><look name="pillar"/><world_transform xyz="3.0 -0.8 2.0" rpy="0.0 0.0 0.0"/></static>
    <static name="PillarR3" type="cylinder"><dimensions radius="0.03" height="4.0"/><material name="Rock"/><look name="pillar"/><world_transform xyz="3.0 0.8 2.0" rpy="0.0 0.0 0.0"/></static>

    <!-- Kilka skał na dnie. -->
    <static name="Rock1" type="sphere"><dimensions radius="0.3"/><material name="Rock"/><look name="rock"/><world_transform xyz="1.5 -1.5 4.0" rpy="0.0 0.0 0.0"/></static>
    <static name="Rock2" type="sphere"><dimensions radius="0.5"/><material name="Rock"/><look name="rock"/><world_transform xyz="3.5 1.8 4.1" rpy="0.0 0.0 0.0"/></static>
    <static name="Rock3" type="box"><dimensions xyz="0.6 0.4 0.3"/><material name="Rock"/><look name="rock"/><world_transform xyz="-1.0 1.2 3.85" rpy="0.0 0.0 0.5"/></static>

    <!-- Znaczniki głębokości 1, 2 i 3 m (scenariusz 4) – czerwone kule przy słupie L0. -->
    <static name="Depth1m" type="sphere"><dimensions radius="0.05"/><material name="Rock"/><look name="buoy"/><world_transform xyz="0.0 -0.8 1.0" rpy="0.0 0.0 0.0"/></static>
    <static name="Depth2m" type="sphere"><dimensions radius="0.05"/><material name="Rock"/><look name="buoy"/><world_transform xyz="0.0 -0.8 2.0" rpy="0.0 0.0 0.0"/></static>
    <static name="Depth3m" type="sphere"><dimensions radius="0.05"/><material name="Rock"/><look name="buoy"/><world_transform xyz="0.0 -0.8 3.0" rpy="0.0 0.0 0.0"/></static>
</scenario>
