<?xml version="1.0"?>
<!-- GENERATED by tools/make_meshes.py from tools/templates/fish_base.scn.in.
     Make changes in the template or in config/default.json and run the generator again. -->
<!--
  Shared definition of the robot fish (included via <include> in every scenario sN_*.scn).

  Coordinate frame: NED (Stonefish) – X forward, Y right, Z DOWN.
  Fish depth = z coordinate (positive below the surface).

  <include> arguments (set in the main scenario file):
    xyz, rpy      – position [m] and orientation [rad] (roll, pitch, yaw) of the head at start
    physics       – body physics mode: "submerged" (buoyancy + drag + added mass) or
                    "surface" (no water forces – only for the internal propulsion test)
    tail_joint    – "revolute" (movable tail) or "fixed" (tail locked, scenario 2)
    vbs_initial   – initial water volume in the VBS [m³]

  Every physical number comes from config/default.json: PLACEHOLDER – to be identified from measurements.
-->
<scenario>
    <looks>
        <look name="fish_body" rgb="0.95 0.55 0.15" roughness="0.4"/>
        <look name="fish_tail" rgb="0.95 0.70 0.30" roughness="0.5"/>
        <look name="fish_fin" rgb="0.90 0.35 0.10" roughness="0.5"/>
        <look name="ballast" gray="0.25" roughness="0.3" metalness="0.8"/>
        <look name="marker" rgb="0.1 0.9 0.9" roughness="0.5"/>
    </looks>

    <robot name="Fish" fixed="false" self_collisions="false">
        <!-- ============================================================ HEAD (base_link)
             Body from the hull mesh (ellipsoid) together with the dorsal fin (one closed mesh –
             union of bodies; the fin damps roll). From the mesh Stonefish computes buoyancy (volume),
             drag (force on every face – see README) and added mass (equivalent ellipsoid).
             Mass, centre of mass and inertia are given explicitly – it is the hull 758.8 g
             (mean density 600.0 kg/m³: shell + air + electronics) TOGETHER with the steel
             ballast 453.1 g (0.09700165946928467 0.035 0.017 m) lying on the hull bottom at 0.015078604116458852 0.0 0.026 m.
             make_meshes.py computes them from the conditions: neutral buoyancy with the VBS at half range
             and trim (centre of mass below the centre of buoyancy). The centre of mass lies LOWER (+z) than the centre
             of buoyancy (ellipsoid centre) -> righting moment after a roll.
             Why not a compound body with the ballast as an internal part: in Stonefish 1.5
             a compound body does not get the added moment of inertia of the water (README, "Thrust diagnosis"). -->
        <base_link name="Head" type="model" physics="$(arg physics)" buoyant="true">
            <physical>
                <mesh filename="meshes/head_phy.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </physical>
            <visual>
                <mesh filename="meshes/head_vis.obj" scale="1.0"/>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </visual>
            <material name="Hull"/>
            <look name="fish_body"/>
            <mass value="1.2248737583429685"/>
            <inertia xyz="0.0010600245758844475 0.003396876867885139 0.0031710297334086104"/>               <!-- principal moments of inertia [kg·m²] -->
            <cg xyz="0.005467264510221281 -2.476169938903902e-22 0.008908036865125321" rpy="-2.2244836207210064e-16 -0.06025959580355424 1.3396537323022461e-17"/>   <!-- centre of mass and principal axes in the head frame -->
        </base_link>

        <!-- ============================================================ TAIL
             Chain of rigid silicone segments (Stonefish does not simulate soft bodies –
             this is a "pseudo-rigid-body" model: flexible tail = rigid links + springs in the joints).
             The frame of each link lies ON its joint, the mesh extends backwards (−X). -->
        <link name="Seg1" type="model" physics="$(arg physics)" buoyant="true">
            <physical><mesh filename="meshes/seg1_phy.obj" scale="1.0"/><origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/></physical>
            <visual><mesh filename="meshes/seg1_vis.obj" scale="1.0"/><origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/></visual>
            <material name="Silicone"/>
            <look name="fish_tail"/>
        </link>
        <link name="Seg2" type="model" physics="$(arg physics)" buoyant="true">
            <physical><mesh filename="meshes/seg2_phy.obj" scale="1.0"/><origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/></physical>
            <visual><mesh filename="meshes/seg2_vis.obj" scale="1.0"/><origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/></visual>
            <material name="Silicone"/>
            <look name="fish_tail"/>
        </link>
        <link name="Seg3" type="model" physics="$(arg physics)" buoyant="true">
            <physical><mesh filename="meshes/seg3_phy.obj" scale="1.0"/><origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/></physical>
            <visual><mesh filename="meshes/seg3_vis.obj" scale="1.0"/><origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/></visual>
            <material name="Silicone"/>
            <look name="fish_tail"/>
        </link>
        <link name="Seg4" type="model" physics="$(arg physics)" buoyant="true">
            <physical><mesh filename="meshes/seg4_phy.obj" scale="1.0"/><origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/></physical>
            <visual><mesh filename="meshes/seg4_vis.obj" scale="1.0"/><origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/></visual>
            <material name="Silicone"/>
            <look name="fish_tail"/>
        </link>
        <link name="Seg5" type="model" physics="$(arg physics)" buoyant="true">
            <physical><mesh filename="meshes/seg5_phy.obj" scale="1.0"/><origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/></physical>
            <visual><mesh filename="meshes/seg5_vis.obj" scale="1.0"/><origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/></visual>
            <material name="Silicone"/>
            <look name="fish_tail"/>
        </link>
        <!-- Caudal fin: thin along Y, tall along Z – when beating in Y it pushes water
             with a large area. A separate link welded to the last segment. -->
        <link name="Fin" type="model" physics="$(arg physics)" buoyant="true">
            <physical><mesh filename="meshes/fin_phy.obj" scale="1.0"/><origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/></physical>
            <visual><mesh filename="meshes/fin_vis.obj" scale="1.0"/><origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/></visual>
            <material name="Silicone"/>
            <look name="fish_fin"/>
        </link>

        <!-- ============================================================ JOINTS
             Rotation about the Z (vertical) axis, limit ±35°.
             The joint <origin> is in the PARENT link frame; the child link frame
             is placed at that point.
             <damping> is the native Stonefish viscous damping (torque −c·θ̇).
             The library has no stiffness (−k·θ) – C++ (TailDriver) adds it via the "motor" actuators. -->
        <joint name="TailJ1" type="$(arg tail_joint)">
            <parent name="Head"/>
            <child name="Seg1"/>
            <origin xyz="-0.11 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 0.0 1.0"/>
            <limits min="-0.6108652381980153" max="0.6108652381980153"/>
            <damping value="0.005"/>
        </joint>
        <joint name="TailJ2" type="$(arg tail_joint)">
            <parent name="Seg1"/>
            <child name="Seg2"/>
            <origin xyz="-0.04 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 0.0 1.0"/>
            <limits min="-0.6108652381980153" max="0.6108652381980153"/>
            <damping value="0.005"/>
        </joint>
        <joint name="TailJ3" type="$(arg tail_joint)">
            <parent name="Seg2"/>
            <child name="Seg3"/>
            <origin xyz="-0.04 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 0.0 1.0"/>
            <limits min="-0.6108652381980153" max="0.6108652381980153"/>
            <damping value="0.005"/>
        </joint>
        <joint name="TailJ4" type="$(arg tail_joint)">
            <parent name="Seg3"/>
            <child name="Seg4"/>
            <origin xyz="-0.04 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 0.0 1.0"/>
            <limits min="-0.6108652381980153" max="0.6108652381980153"/>
            <damping value="0.005"/>
        </joint>
        <joint name="TailJ5" type="$(arg tail_joint)">
            <parent name="Seg4"/>
            <child name="Seg5"/>
            <origin xyz="-0.04 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 0.0 1.0"/>
            <limits min="-0.6108652381980153" max="0.6108652381980153"/>
            <damping value="0.005"/>
        </joint>
        <joint name="FinJoint" type="fixed">
            <parent name="Seg5"/>
            <child name="Fin"/>
            <origin xyz="-0.04 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </joint>

        <!-- ============================================================ TAIL DRIVE
             The "motor" actuator (present in the Stonefish 1.5 parser, although undocumented)
             applies the commanded TORQUE at the joint: +τ on the child link, −τ on the parent
             (Featherstone, generalized joint force). The drive is therefore INTERNAL: action = reaction.
             C++ sets the torque value at every step: τ_i = w_i·A_eff·r_eff·(p_L − p_R) − k_i·θ_i.
             A "servo" is not suitable: in v1.5 it only has position and velocity modes
             (the TORQUE mode is in the header, but Servo::Update treats it as velocity). -->
        <actuator name="TailM1" type="motor"><joint name="TailJ1"/></actuator>
        <actuator name="TailM2" type="motor"><joint name="TailJ2"/></actuator>
        <actuator name="TailM3" type="motor"><joint name="TailJ3"/></actuator>
        <actuator name="TailM4" type="motor"><joint name="TailJ4"/></actuator>
        <actuator name="TailM5" type="motor"><joint name="TailJ5"/></actuator>

        <!-- Fin lift (which Stonefish does not compute for plain bodies) is added in C++
             (src/FinLift.cpp) as an actuator attached to the "Fin" link – see README. -->

        <!-- ============================================================ VBS (depth control)
             Water tank with a volume of 5e-07 … 4.05e-05 m³ (from the empty/full meshes).
             The C++ pump changes the volume with a limited flow rate (VariableBuoyancy::setFlowRate).
             More water = more weight = the fish sinks. The tank lies ABOVE the hull axis (−z)
             and at the X of the whole fish's centre of buoyancy, so filling does not change the trim. -->
        <actuator name="VBS" type="vbs">
            <volume initial="$(arg vbs_initial)">
                <mesh filename="meshes/vbs_empty.obj"/>
                <mesh filename="meshes/vbs_full.obj"/>
            </volume>
            <origin xyz="-0.041 0.0 -0.015" rpy="0.0 0.0 0.0"/>
            <link name="Head"/>
        </actuator>

        <!-- ============================================================ SENSORS
             The depth controller works on the pressure sensor READING (noisy),
             not on the true position from the simulator – as in the real robot. -->
        <sensor name="Pressure" type="pressure" rate="50.0">
            <range pressure="200000.0"/>
            <noise pressure="50.0"/>
            <history samples="1"/>
            <origin xyz="0.1 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <link name="Head"/>
        </sensor>
        <sensor name="IMU" type="imu" rate="100.0">
            <noise angle="0.005 0.005 0.01" angular_velocity="0.01" yaw_drift="0.0" linear_acceleration="0.05"/>
            <history samples="1"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <link name="Head"/>
        </sensor>
        <!-- Tail joint encoders (angle and angular velocity). -->
        <sensor name="Enc1" type="encoder"><history samples="1"/><joint name="TailJ1"/></sensor>
        <sensor name="Enc2" type="encoder"><history samples="1"/><joint name="TailJ2"/></sensor>
        <sensor name="Enc3" type="encoder"><history samples="1"/><joint name="TailJ3"/></sensor>
        <sensor name="Enc4" type="encoder"><history samples="1"/><joint name="TailJ4"/></sensor>
        <sensor name="Enc5" type="encoder"><history samples="1"/><joint name="TailJ5"/></sensor>

        <world_transform xyz="$(arg xyz)" rpy="$(arg rpy)"/>
    </robot>
</scenario>
