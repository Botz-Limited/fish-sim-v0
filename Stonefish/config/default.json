// All Stonefish demo parameters in one file (JSON with // comments).
//
// NOTE: this is NOT a calibrated model. Every value marked
// "PLACEHOLDER – to be identified from measurements" is an order-of-magnitude guess.
// The values are deliberately THE SAME as in the MuJoCo demo (../MuJoCo/fishsim/config.py),
// so that the results of both simulators can be compared.
//
// Who reads which sections:
//   geometry, materials, joints, vbs  -> tools/make_meshes.py (OBJ meshes + data/scenarios/fish_base.scn)
//   sim, tail, hydraulics, rhythm, depth, heading, log -> C++ program (at every start, no recompilation)
// After changing geometry/materials/joints/vbs, rerun tools/make_meshes.py.
// The config/sN_*.json files override selected fields of this file (JSON merge-patch merging),
// and the --set section.key=value option overrides a single field from the command line.
{
  // ---------------------------------------------------------------- simulation
  "sim": {
    "scenario": "s1_hover.scn",     // XML file in data/scenarios/
    // [Hz] physics step 0.5 ms. At 2 ms (as in MuJoCo) the joint springs −k·θ, computed
    // explicitly, become unstable: light, short segments (Seg4: 36 g) between two
    // springs have a vibration mode with ω·dt > 2. 1000 Hz already works, 2000 Hz is a x2 margin.
    "steps_per_second": 2000,
    // By default Stonefish recomputes hydrodynamic forces every sps/50 steps (50 Hz)
    // and holds them constant in between. With a 2–3 Hz tail that is only 15–25 samples per cycle,
    // so we compute them in EVERY step (1). Slower, but without steps in the force.
    "fluid_prescaler": 1,
    "duration": 10.0,               // [s] simulation time in the console application
    "realtime_factor": 1.0          // graphical application only
  },

  // ---------------------------------------------------------------- geometry (meshes)
  // The Stonefish coordinate frame is NED: +X forward (nose), +Y to the right (starboard),
  // +Z DOWN. Depth = +z. The tail flaps in the XY plane (joints about the Z axis).
  "geometry": {
    "hull_semi_axes": [0.125, 0.05, 0.05],  // [m] head/hull: ellipsoid 25 x 10 x 10 cm; PLACEHOLDER – to be identified from measurements
    "n_segments": 5,                        // number of rigid tail segments
    "tail_attach_x": -0.11,                 // [m] 1st joint relative to the hull center
    "segment_length": 0.04,                 // [m] distance between joints; PLACEHOLDER – to be identified from measurements
    "segment_ry0": 0.030,                   // [m] Y semi-axis (thickness) of the 1st segment; PLACEHOLDER – to be identified from measurements
    "segment_rz0": 0.040,                   // [m] Z semi-axis (height) of the 1st segment; PLACEHOLDER – to be identified from measurements
    "taper_last": 0.4,                      // [-] cross-section scale of the last segment relative to the 1st
    "segment_overlap": 0.002,               // [m] segments overlap each other (no gaps)
    "fin_semi_axes": [0.035, 0.003, 0.06],  // [m] fin: thin in Y, tall in Z; PLACEHOLDER – to be identified from measurements
    // Dorsal fin: a thin vertical plate on the back of the head. It damps ROLL: a smooth
    // ellipsoid rotating about its own axis offers almost no resistance (the faces slide tangentially),
    // and Stonefish assumes zero added inertia for rotation about the X axis. Without the dorsal
    // fin the fish rocks ±10–20° for many seconds after a roll (README, scen. 1).
    // Half of the ellipsoid is hidden inside the hull (the mesh displaces water twice only in that part –
    // negligible: ~1% of the fish volume). "dorsal_enabled": false removes it from the model.
    "dorsal_enabled": true,
    "dorsal_semi_axes": [0.045, 0.0025, 0.035], // [m] PLACEHOLDER – to be identified from measurements
    "dorsal_center": [-0.01, 0.0, -0.06],       // [m] in the head frame (NED: −z = up)
    // Mesh resolution: physical (hydrodynamics computed on EVERY face,
    // so few triangles) and visual (smooth, for rendering only).
    "phys_subdiv": 2,                       // icosphere 2 -> 320 triangles per ellipsoid
    "vis_subdiv": 4                         // icosphere 4 -> 5120 triangles
  },

  // ---------------------------------------------------------------- materials
  "materials": {
    "rho_water": 1000.0,     // [kg/m³] fresh water (physical value, as in MuJoCo)
    "rho_hull": 600.0,       // [kg/m³] average density of shell + air + electronics; PLACEHOLDER – to be identified from measurements
    "rho_tail": 1100.0,      // [kg/m³] silicone (Ecoflex/Dragon Skin ~1070–1140); PLACEHOLDER – to be identified from measurements
    "rho_ballast": 7850.0,   // [kg/m³] steel – ballast at the bottom of the hull (physical value)
    // Ballast: a box at the bottom of the hull. Its MASS and X position are computed by
    // make_meshes.py from the conditions: (1) neutral buoyancy with the VBS at mid-range,
    // (2) longitudinal trim (center of mass below the center of buoyancy). Only the cross-section is given here.
    "ballast_width": 0.035,  // [m] Y dimension
    "ballast_height": 0.017, // [m] Z dimension
    "ballast_z": 0.026       // [m] ballast center BELOW the hull axis (NED: +z down) -> center of mass below center of buoyancy
  },

  // ---------------------------------------------------------------- joints (XML)
  "joints": {
    "limit_deg": 35.0,       // [deg] limit of each tail joint
    // Viscous joint damping (native in Stonefish: <damping value=.../>,
    // torque −c·θ̇ added in every step). Stiffness is NOT native – see "tail".
    "damping": 0.005         // [N·m·s/rad] material damping of the silicone; PLACEHOLDER – to be identified from measurements
  },

  // ---------------------------------------------------------------- VBS (Variable Buoyancy System)
  // In Stonefish 1.5 the VBS is a tank into which we PUMP WATER: it adds the weight ρ·V·g
  // at the center of the water volume. More water = heavier fish. The volume range is defined by
  // the "empty" and "full" meshes (volume interpolated linearly).
  "vbs": {
    "v_min": 0.5e-6,         // [m³] 0.5 ml – the "empty" mesh must have a nonzero volume (library requirement)
    "v_max": 40.5e-6,        // [m³] 40.5 ml -> usable range of 40 ml like the bladder in MuJoCo; PLACEHOLDER – to be identified from measurements
    "center": [-0.041, 0.0, -0.015], // [m] tank center in the hull frame: X ≈ center of buoyancy of the whole fish
                                      // (filling does not change the trim), Z above the axis (−z = up)
    "q_max": 10e-6,          // [m³/s] max. flow rate of the ballast pump (10 ml/s); PLACEHOLDER – to be identified from measurements
    "k_track": 5.0           // [1/s] gain of V_ref tracking by the ballast pump
  },

  // ---------------------------------------------------------------- fin lift (C++, src/FinLift.cpp)
  // For ordinary bodies Stonefish 1.5 computes only buoyancy, added mass and DRAG (force on each face
  // along the relative velocity) – no lift. Without it the fish barely swims (README,
  // "Thrust diagnosis"). We add fin lift: C_L = ½·C_Lα·sin(2α), L = ½ρ·S·C_L·u².
  // S = π·a·c from geometry.fin_semi_axes (side projection of the fin), point of application = fin center.
  "fin_lift": {
    "enabled": true,         // false = pure Stonefish hydrodynamics from geometry
    "cl_alpha": 2.8          // [1/rad] slope of C_L(α) for small angles; fin with aspect ratio ~2.2
                             // (Helmbold formula) – PLACEHOLDER – to be identified from measurements
  },

  // ---------------------------------------------------------------- skin friction drag (C++ -> Stonefish API)
  // Stonefish computes friction LINEARLY: F = ρ·c·Σ A·v_t (v_t – tangential velocity of the face). By default
  // c = 0.1·Cd (Cd normalized to 1), i.e. ~0.1 m/s – for a small fish several dozen times more
  // than the physical friction (README, "Thrust diagnosis"). Options:
  //   "library" – coefficients estimated automatically by the library,
  //   "blasius" – laminar boundary layer friction (Blasius): C_f = 1.328/√Re, Re = U_ref·L/ν,
  //               linearized at U_ref: ½ρ·C_f·U² ≈ ρ·c·U  ->  c = ½·C_f·U_ref.
  //               L = length of the whole fish. Same as the <hydrodynamics viscous_drag="c c c"/> attribute in XML.
  "hydro": {
    "skin_friction": "blasius",
    "U_ref": 0.2,            // [m/s] speed at which friction is linearized; PLACEHOLDER – order of the swimming speed
    "nu": 1.0e-6             // [m²/s] kinematic viscosity of water ~20°C (physical value)
  },

  // ---------------------------------------------------------------- sensors (XML)
  "sensors": {
    "pressure_rate": 50.0,   // [Hz] pressure sensor sampling rate
    "pressure_noise": 50.0,  // [Pa] noise standard deviation (50 Pa ≈ 5 mm of water); PLACEHOLDER – to be identified from measurements
    "imu_rate": 100.0,       // [Hz]
    "imu_noise_angle": [0.005, 0.005, 0.01], // [rad] roll, pitch, yaw; PLACEHOLDER – to be identified from measurements
    "imu_noise_gyro": 0.01,  // [rad/s] PLACEHOLDER – to be identified from measurements
    "imu_yaw_drift": 0.0,    // [rad/s] heading drift
    "imu_noise_acc": 0.05    // [m/s²] PLACEHOLDER – to be identified from measurements
  },

  // ---------------------------------------------------------------- tail (C++)
  "tail": {
    "n_actuated": 3,         // K – how many of the first joints are driven by hydraulics (the rest are passive)
    "tendon_weight_last": 0.4, // weight of the last actuated joint (w_1 = 1, decreasing linearly)
    // Joint stiffness k·θ (silicone as a torsion spring, pseudo-rigid-body model).
    "stiffness_actuated": 0.3, // [N·m/rad] actuated joints (chamber walls) – as in MuJoCo; PLACEHOLDER – to be identified from measurements
    // Passive joints: stiffness COMPUTED (same rule as in MuJoCo) from the given resonance:
    //   k = I·(2π·f_res)², I – inertia of the tail part BEHIND the joint about its axis,
    //   including added mass – as computed by Stonefish (getAugmentedMass/Inertia).
    // We do not copy the MuJoCo numbers (1.287 and 0.528), because Stonefish computes added mass differently.
    "passive_resonance_hz": 3.0, // [Hz] PLACEHOLDER – to be identified from measurements
    "stiffness_override": null,  // or an array of k for all joints [N·m/rad] – then nothing is computed
    "locked": false          // true = no torques applied in C++ (the locked-tail variant
                             // uses a separate scenario with "fixed" joints)
  },

  // ---------------------------------------------------------------- tail hydraulics (C++)
  "hydraulics": {
    "A_eff": 4e-4,           // [m²] effective area of the chamber wall; PLACEHOLDER – to be identified from measurements
    "r_eff": 0.05,           // [m] effective force lever arm; PLACEHOLDER – to be identified from measurements
    "C_h": 8e-11,            // [m³/Pa] chamber compliance (walls + compressibility); PLACEHOLDER – to be identified from measurements
    "p_max": 50e3,           // [Pa] relief valve opening pressure; PLACEHOLDER – to be identified from measurements
    "V0_chamber": 30e-6,     // [m³] volume of each chamber with a straight tail; PLACEHOLDER – to be identified from measurements
    "Q_max": 60e-6,          // [m³/s] max. flow rate of the tail pump (60 ml/s); PLACEHOLDER – to be identified from measurements
    "tau_pump": 0.03         // [s] pump time constant; PLACEHOLDER – to be identified from measurements
  },

  // ---------------------------------------------------------------- tail rhythm / CPG (C++)
  // The generator sets the pumped VOLUME V_ref = A_V·sin(2πft) + V_bias, and the pump
  // command is u = (dV_ref/dt + K_v·(V_ref − V_p))/Q_max. Why not u = A·sin + bias
  // directly – see README (section "Control").
  "rhythm": {
    "enabled": false,
    "freq": 2.0,             // [Hz] flapping frequency
    "volume_amp": 8e-6,      // [m³] amplitude A_V (8 ml ≈ 0.4 rad of tendon); PLACEHOLDER – to be identified from measurements
    "volume_bias": 0.0,      // [m³] V_bias – constant tail deflection (turn); + = to the right (+Y)
    "K_v": 10.0,             // [1/s] volume error correction
    "ramp_time": 1.0         // [s] soft start of the amplitude
  },

  // ---------------------------------------------------------------- depth controller (C++)
  // Input: PRESSURE SENSOR READING (with noise) -> depth -> low-pass filter.
  // Output: setpoint water volume in the VBS V_ref (more water = down).
  "depth": {
    "enabled": false,
    "schedule": [[0.0, 1.0]],  // [[t, z_ref], ...] – depth setpoint [m] (NED: + down), stepwise from time t
    // Gains from the model (README, scenario 4), not from MuJoCo: vertical motion is m·z̈ = −ρg·ΔV,
    // m ≈ 2.6 kg (fish + water in VBS + added mass). For ω_n = 0.3 rad/s and ζ ≈ 1:
    //   kp = ω_n²·m/(ρg) ≈ 24 ml/m,  kd = 2ζ·ω_n·m/(ρg) ≈ 160 ml/(m/s).
    // Slower than in MuJoCo, because the VBS pump (10 ml/s) cannot keep up with a faster controller
    // and a "wall to wall" limit cycle appears (verified: MuJoCo gains -> ±10–40 cm).
    "kp": 24e-6,             // [m³/m]
    "ki": 1.5e-6,            // [m³/(m·s)] removes a small steady-state error
    "kd": 160e-6,            // [m³·s/m] acts on the filtered velocity (not on the error – no "kick")
    "i_band": 0.2,           // [m] integrate only when |error| < 0.2 m (otherwise wind-up on large steps)
    "lpf_cutoff_hz": 1.0,    // [Hz] first-order low-pass filter on the sensor depth
    "z_min": 0.3             // [m] shallowest allowed depth setpoint
  },

  // ---------------------------------------------------------------- heading controller (C++, scenario 5)
  // Input: yaw from the IMU. Output: tail V_bias (turn).
  "heading": {
    "enabled": false,
    "yaw_ref_deg": 0.0,      // [deg] heading setpoint (0 = world X axis, "north")
    "kp": 5e-6,              // [m³/rad] PLACEHOLDER – tuned in scenario 5
    "ki": 1e-6,              // [m³/(rad·s)]
    "bias_max": 4e-6         // [m³] V_bias limit (as in MuJoCo: ±4 ml)
  },

  // ---------------------------------------------------------------- CSV logging
  "log": {
    "every_n_steps": 20      // write every 20 steps = 100 Hz
  }
}
